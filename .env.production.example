# Copy to .env.production.local; secret values live in .secrets, not here.
COMPOSE_PROJECT_NAME=culinary-production
APP_TAG=lab8
PUBLIC_HOST=example.com
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_ORIGIN=https://example.com
MEDIA_PUBLIC_ORIGIN=https://example.com:9443
HTTP_PORT=80
HTTPS_PORT=443
MEDIA_HTTPS_PORT=9443
HSTS_MAX_AGE=31536000
SECRETS_DIR=./.secrets
TLS_DIR=./.secrets/tls
BACKUP_DIR=./artifacts/lab8/backups
RESTORE_DIR=./artifacts/lab8/restored
POSTGRES_USER=culinary
POSTGRES_DB=culinary_blog
PROXY_IP=172.31.88.10
PRODUCTION_SUBNET=172.31.88.0/24
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
NEXT_IMAGE_UNOPTIMIZED=false
