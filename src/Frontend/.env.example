# Copy file này thành .env.local rồi điền giá trị thật.
# .env.local đã nằm trong .gitignore nên không bị đẩy lên GitHub.

NEXTAUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, mỗi người tự sinh một chuỗi riêng.
NEXTAUTH_SECRET=thay-bang-chuoi-ngau-nhien-cua-rieng-ban

# Backend API - SRS mục 5.2: http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000
API_URL=http://localhost:5000

# Chỉ cần khi làm FR-AUTH-003 (đăng nhập Google).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
